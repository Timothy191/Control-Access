#!/bin/bash
# Hugging Face Model Downloader
# Download small efficient models for terminal use

MODELS=(
  "HuggingFaceTB/SmolLM2-135M:HuggingFaceTB/SmolLM2-135M"
  "HuggingFaceTB/SmolLM2-360M:HuggingFaceTB/SmolLM2-360M"
  "HuggingFaceTB/SmolLM2-1.7B:HuggingFaceTB/SmolLM2-1.7B"
  "microsoft/Phi-4-mini:microsoft/Phi-4-mini"
  "google/gemma-3-1b-it:google/gemma-3-1b-it"
  "Qwen/Qwen3-0.5B:Qwen/Qwen3-0.5B"
  "tiiuae/falcon-h1-tiny:tiiuae/falcon-h1-tiny"
)

install_hf() {
  pip install -q huggingface-hub transformers accelerate 2>/dev/null
}

download_model() {
  local model="$1"
  echo "Downloading: $model"
  python3 -c "
from huggingface_hub import snapshot_download
snapshot_download(repo_id='$model', local_dir='$HOME/ai-hub/models/$model')
print('Done!')
" 2>/dev/null || echo "Install huggingface-hub first"
}

case "$1" in
  list) 
    echo "Available Models:"
    for m in "${MODELS[@]}"; do echo "  - ${m%%:*}"; done
    ;;
  install) install_hf ;;
  *) download_model "$1" ;;
esac
