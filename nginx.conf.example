# nginx reverse-proxy config for Mine Management System
# Copy to /etc/nginx/sites-available/mine-management
# Then: ln -s /etc/nginx/sites-available/mine-management /etc/nginx/sites-enabled/
#
# For HTTPS with Let's Encrypt (internet-facing):
#   certbot --nginx -d your.domain.com
#
# For HTTPS with self-signed cert (LAN only):
#   openssl req -x509 -nodes -days 3650 -newkey rsa:4096 \
#     -keyout /etc/ssl/private/mine-management.key \
#     -out /etc/ssl/certs/mine-management.crt \
#     -subj "/CN=mine-management"

upstream mine_app {
    server 127.0.0.1:8080;
    keepalive 32;
}

# Redirect HTTP -> HTTPS
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name _;

    ssl_certificate     /etc/ssl/certs/mine-management.crt;
    ssl_certificate_key /etc/ssl/private/mine-management.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers (supplement app-level headers)
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 20M;
    proxy_read_timeout 120s;

    # Static files served directly by nginx
    location /static/ {
        alias /opt/mine-management/static/;
        expires 12h;
        add_header Cache-Control "public, max-age=43200";
    }

    # WebSocket upgrade for SocketIO
    location /socket.io/ {
        proxy_pass http://mine_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # All other requests proxied to gunicorn
    location / {
        proxy_pass http://mine_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
