# Arch-System Environment Variables
# Copy this file to .env and fill in real values before running the app.
# NEVER commit .env to version control.

# ---- REQUIRED IN PRODUCTION ----

# Flask Secret Key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Hardware API Key for QR scanner authentication — generate with: python -c "import secrets; print(secrets.token_hex(32))"
HARDWARE_API_KEY=

# Mobile app API key (optional second key for the mobile scanner app)
MOBILE_API_KEY=

# Admin password on first run (only used if no admin user exists yet)
# If not set, a secure random password is generated and printed to console once.
ADMIN_PASSWORD=

# Visitor request PIN (default 1234 — change before go-live)
VISITOR_PIN=

# ---- ENVIRONMENT ----

# Set to 'production' (default) or 'development'
# In development mode, SECRET_KEY is not required (a random one is used).
FLASK_ENV=production

# Set to 'true' if running behind HTTPS (nginx/Caddy with TLS).
# Enables Secure cookie flag.
HTTPS=false

# ---- LOGGING ----

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: write logs to a rotating file (leave empty to log to stdout only)
LOG_FILE=

# ---- CORS ----

# Restrict API CORS origins (comma-separated). Use * to allow all (default for dev).
# Example: CORS_ORIGINS=http://192.168.0.0/24,http://10.0.0.0/8
CORS_ORIGINS=*

# ---- OLLAMA AI ----

# Local: Set OLLAMA_URL to your local Ollama instance
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mine-assistant-fast
OLLAMA_MODEL_FULL=mine-assistant

# Cloud: Set OLLAMA_USE_CLOUD=true and provide your cloud API key
OLLAMA_USE_CLOUD=false
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_URL=https://cloud.ollama.ai/api

# ---- PORTKEY AI GATEWAY (optional) ----
# When PORTKEY_API_KEY is set, ALL AI requests (including cached tokens) are routed
# through Portkey's AI gateway for centralized observability, caching, and routing.
# Portkey uses the x-portkey-api-key header for authentication.
# Leave empty to use local Ollama directly.
PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://api.portkey.ai/v1
# Optional: Portkey virtual key for specific provider routing
PORTKEY_VIRTUAL_KEY=

# ---- DATABASE ----

# Azure SQL / SQL Server (production — recommended for Power Apps & Power BI integration)
# Example: mssql+pyodbc://username@your-server:your-password@your-server.database.windows.net/control-access-db?driver=ODBC+Driver+17+for+SQL+Server
# DATABASE_URL=mssql+pyodbc://...

# SQLite (local development — used automatically when DATABASE_URL is not set)
DATABASE_URL=

# ---- SHAREPOINT INTEGRATION (optional) ----
# For Power Apps and Power BI integration
# Leave empty to disable SharePoint sync
SHAREPOINT_USERNAME=
SHAREPOINT_PASSWORD=
SHAREPOINT_SITE_URL=
SHAREPOINT_EMPLOYEE_LIST=Employees
SHAREPOINT_SYNC_INTERVAL=300
SHAREPOINT_AUTO_SYNC=false