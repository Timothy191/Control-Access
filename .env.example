# Mine Management System Environment Variables

# Google Gemini API Key (for AI chat functionality)
GOOGLE_API_KEY=your-gemini-api-key-here

# Hardware API Key (for QR scanner authentication)
HARDWARE_API_KEY=9b862d34e04d209d1cf6fbcb1ccf78c30083afddc8afbed8246ece65964f3bf9

# Flask Secret Key (for session security)
SECRET_KEY=your-secret-key-change-this-in-production

# Mobile Scanner API Key (built into the mobile app)
MOBILE_API_KEY=ab22b3e234e5cc2f6a9377490da6be0c

# Network Scanner Auth Token (for WiFi device scan authentication)
# Devices on the same WiFi network must send this token to submit scans
NETWORK_SCANNER_AUTH_TOKEN=mine-net-scan-2024
