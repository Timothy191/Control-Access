# Control-Access Mine Site Management System — Environment Configuration
# Copy this file to .env and fill in production values before running.
# NEVER commit .env containing production secrets to version control.

# ---- REQUIRED SECURITY & AUTHENTICATION ----

# Flask Secret Key — used for session encryption
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Hardware API Key for QR scanner hardware & terminal authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
HARDWARE_API_KEY=

# Mobile app API key (optional secondary key for mobile scanner app)
MOBILE_API_KEY=

# AES-128-CBC Key for PII field-level encryption (encrypts employee ID, medical data, visitor names)
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=

# Admin password on first database creation (only used on initial setup)
# If not set, defaults to "admin" or prompt warning on startup.
ADMIN_PASSWORD=

# Set to "true" to force reset of admin password on startup (default: false)
RESET_ADMIN_PASSWORD=false

# Visitor request registration PIN (default: 1234 — MUST change for production go-live)
VISITOR_PIN=1234

# ---- ENVIRONMENT & SECURITY SETTINGS ----

# Set to 'production' or 'development'
FLASK_ENV=production

# Set to 'true' if running behind HTTPS reverse proxy (enables Secure cookies)
HTTPS=false

# CORS Allowed Origins (comma-separated). Set explicit domains in production.
# Example: CORS_ORIGINS=https://access.yourdomain.com,https://mobile.yourdomain.com
CORS_ORIGINS=*

# ---- REDIS & RATE LIMITING ----

# Redis URL for production rate limiting state & session persistence across worker processes
# If empty, falls back to in-memory rate limiting (memory://)
REDIS_URL=redis://localhost:6379/0

# Optional rate limiter storage URI override (takes precedence if set)
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# ---- LOGGING & MONITORING ----

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: File path for rotating security/application log output (e.g. /var/log/control-access.log)
LOG_FILE=

# ---- DATABASE CONFIGURATION ----

# Azure SQL / SQL Server (Production recommended)
# Example: mssql+pyodbc://username:password@server.database.windows.net/dbname?driver=ODBC+Driver+17+for+SQL+Server
DATABASE_URL=

# SQLite Fallback (Local Development — used automatically if DATABASE_URL is empty)
# SQLITE_DATABASE_URL=sqlite:////path/to/mine_management.db

# ---- AI ASSISTANT & GATEWAY CONFIGURATION ----

# Enable or disable AI assistant endpoints & UI chat drawer (default: true)
ENABLE_AI_CHAT=true

# Local Ollama LLM endpoint
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mine-assistant-fast
OLLAMA_MODEL_FULL=mine-assistant

# Cloud Ollama endpoint (optional)
OLLAMA_USE_CLOUD=false
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_URL=https://cloud.ollama.ai/api

# Portkey AI Gateway Integration (optional)
# When PORTKEY_API_KEY is set, AI requests are routed through Portkey for caching & observability.
PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_VIRTUAL_KEY=

# ---- SHAREPOINT INTEGRATION (Optional Read-Only Sync) ----
SHAREPOINT_USERNAME=
SHAREPOINT_PASSWORD=
SHAREPOINT_SITE_URL=
SHAREPOINT_EMPLOYEE_LIST=Employees
SHAREPOINT_SYNC_HOURS=0,6,12,18
SHAREPOINT_AUTO_SYNC=false
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_TENANT_ID=